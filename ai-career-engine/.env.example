# ==================================================
# AI CAREER ENGINE - ENVIRONMENT & API KEY CONFIG
# ==================================================

# 1. Primary AI Provider (NVIDIA Nemotron / Gemini / OpenAI / Anthropic / Local Ollama)
LLM_PROVIDER=nemotron

# NVIDIA Nemotron Config (NVIDIA NIM / OpenAI-compatible endpoint)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Google Gemini Config (Alternative Provider)
GEMINI_API_KEY=your_google_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004

# OpenAI Config (Alternative Provider)
OPENAI_API_KEY=your_openai_api_key_here

# Live Job Market Data Provider (Optional - for real-time job posting ingestion)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOOBLE_API_KEY=your_jooble_api_key

# Deployment Environment Settings
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
