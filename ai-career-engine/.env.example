# ==================================================
# AI CAREER ENGINE - ENVIRONMENT & API KEY CONFIG
# ==================================================

# 1. Primary AI Provider (Gemini / OpenAI / Anthropic / Local Ollama / DeepSeek)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004


# 2. Alternative LLM Provider (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# 3. Live Job Market Data Provider (Optional - for real-time job posting ingestion)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOOBLE_API_KEY=your_jooble_api_key

# 4. Deployment Environment Settings
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
